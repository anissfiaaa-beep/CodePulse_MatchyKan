# Copy this file to .env for local development. Never commit the completed .env.
# In Replit, configure these names in Secrets instead.
# The API key must be the generated token, not a URL, key name, or key ID.
RUNPOD_API_KEY=
# Use a Serverless endpoint ID or its https://api.runpod.ai/v2/... API URL.
RUNPOD_ENDPOINT_ID=
